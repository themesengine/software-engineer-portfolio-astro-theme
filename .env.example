# ---------------------------------------------------------------------
# Copy this file to `.env`, then fill in your values. Never commit real
# secrets.
# ---------------------------------------------------------------------

# ── Site ─────────────────────────────────────────────────────────────
# Public URL of the website, without a trailing slash. Used for
# canonical links, social images, sitemap.xml, robots.txt and
# structured data. Embedded at BUILD time: rebuild after changing it.
PUBLIC_SITE_URL=http://localhost:4321

# "true" asks search engines not to index the site and disallows all
# crawling in robots.txt. Use it on staging sites. Set before building.
PUBLIC_SITE_NOINDEX=false

# ── Server ───────────────────────────────────────────────────────────
# Used by `yarn start` (server.mjs). Docker sets these for you.
HOST=localhost
PORT=4321

# ── Form delivery ────────────────────────────────────────────────────
# Read at RUNTIME by the server. Configure at least one transport for
# production. Submissions are sent to every configured transport. A
# production build returns an error if none is configured, so requests
# are never silently lost.

# Option A: webhook (Zapier, Make, n8n, Slack workflow, your CRM, ...).
# Each submission is POSTed as JSON.
FORM_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <secret>".
FORM_WEBHOOK_SECRET=

# Option B: email through Resend (https://resend.com).
RESEND_API_KEY=
# Comma-separated list of recipients.
FORM_EMAIL_TO=
# Must use a domain verified in Resend, e.g. "Mira Castell <web@your-domain.com>"
FORM_EMAIL_FROM=

# ── Demo ─────────────────────────────────────────────────────────────
# "true" accepts form submissions without sending them anywhere.
# Only for public demos. Never enable on a live website.
DEMO_MODE=false
