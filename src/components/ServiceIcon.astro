---
// Small line icons for services. Add a new key and path to extend.
const {
    name
} = Astro.props;

const paths = {
    build: "M4 7h16M4 7v11a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V7M4 7l2-3h12l2 3M9 12l-2 2 2 2M15 12l2 2-2 2",
    api: "M5 6h4v4H5zM15 14h4v4h-4zM15 6h4v4h-4zM9 8h6M17 10v4M7 10v6a2 2 0 0 0 2 2h6",
    audit: "M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM16 16l4 4M8 11l2 2 4-4",
    lead: "M12 4a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM6 20v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2M4 9h2M18 9h2"
};
---

<svg
    class="service-icon"
    viewBox="0 0 24 24"
    width="24"
    height="24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
>
    <path d={paths[name] || paths.build}/>
</svg>
