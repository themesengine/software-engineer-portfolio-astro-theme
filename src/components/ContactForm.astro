---
/*
 * General contact form on /contact. Options and validation live in
 * src/lib/forms/contact.js; submissions go to src/pages/api/contact.js.
 * Project enquiries use EnquiryForm.astro on /hire instead.
 */
import HoneypotField from "@/components/HoneypotField.astro";
import {
    enquiryOptions
} from "@/lib/forms/contact";

const id = "contact-form";
---

<form
    id={id}
    class="form"
    action="/api/contact"
    method="post"
    novalidate
    data-contact-form
>
    <div class="form__field">
        <label
            class="form__label"
            for={`${id}-name`}
        >
            Name
        </label>

        <input
            id={`${id}-name`}
            class="form__input"
            name="name"
            type="text"
            autocomplete="name"
            required
            aria-describedby={`${id}-name-error`}
        />

        <p
            id={`${id}-name-error`}
            class="form__error"
            hidden
        ></p>
    </div>

    <div class="form__field">
        <label
            class="form__label"
            for={`${id}-email`}
        >
            Email
        </label>

        <input
            id={`${id}-email`}
            class="form__input"
            name="email"
            type="email"
            autocomplete="email"
            required
            aria-describedby={`${id}-email-error`}
        />

        <p
            id={`${id}-email-error`}
            class="form__error"
            hidden
        ></p>
    </div>

    <div class="form__field">
        <label
            class="form__label"
            for={`${id}-phone`}
        >
            Phone <span class="form__optional">(optional)</span>
        </label>

        <input
            id={`${id}-phone`}
            class="form__input"
            name="phone"
            type="tel"
            autocomplete="tel"
            aria-describedby={`${id}-phone-error`}
        />

        <p
            id={`${id}-phone-error`}
            class="form__error"
            hidden
        ></p>
    </div>

    <div class="form__field">
        <label
            class="form__label"
            for={`${id}-enquiryType`}
        >
            Topic
        </label>

        <select
            id={`${id}-enquiryType`}
            class="form__input"
            name="enquiryType"
            aria-describedby={`${id}-enquiryType-error`}
        >
            {enquiryOptions.map((option) => (
                <option value={option.value}>
                    {option.label}
                </option>
            ))}
        </select>

        <p
            id={`${id}-enquiryType-error`}
            class="form__error"
            hidden
        ></p>
    </div>

    <div class="form__field">
        <label
            class="form__label"
            for={`${id}-message`}
        >
            Message
        </label>

        <textarea
            id={`${id}-message`}
            class="form__input"
            name="message"
            rows="6"
            required
            aria-describedby={`${id}-message-error`}
        ></textarea>

        <p
            id={`${id}-message-error`}
            class="form__error"
            hidden
        ></p>
    </div>

    <HoneypotField formId={id}/>

    <p
        class="form__message"
        data-form-message
        role="alert"
        hidden
    ></p>

    <div class="form__actions">
        <button
            class="button"
            type="submit"
        >
            Send message
        </button>

        <p class="form__privacy">
            I use your details only to reply. See the <a href="/privacy">privacy policy</a>.
        </p>
    </div>
</form>

<div
    id={`${id}-success`}
    class="form__success"
    tabindex="-1"
    hidden
>
    <p class="form__success-title">
        Message sent
    </p>
    <p data-form-success-message></p>
</div>

<script>
    import {
        normalizeContactRequest,
        validateContactRequest
    } from "@/lib/forms/contact";
    import {
        enhanceForm
    } from "@/scripts/enhanceForm";

    document.querySelectorAll("[data-contact-form]").forEach((form) => {
        enhanceForm(form, {
            normalize: normalizeContactRequest,
            validate: validateContactRequest
        });
    });
</script>
